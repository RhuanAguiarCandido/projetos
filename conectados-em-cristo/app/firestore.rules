rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function adm() {
      return logado() && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Hinos e agenda: todos leem, só o Adm altera
    match /hinos/{id}   { allow read: if true; allow write: if adm(); }
    match /cultos/{dia} { allow read: if true; allow write: if adm(); }

    // Favoritos e grifos pessoais: cada um só mexe no seu
    match /usuarios/{uid} { allow read, write: if logado() && request.auth.uid == uid; }

    // Lista de administradores (documento com o e-mail como ID): cada um só consulta o próprio
    match /admins/{email} {
      allow read: if logado() && request.auth.token.email == email;
      allow write: if false; // adicione Adms pelo console do Firebase
    }
  }
}
